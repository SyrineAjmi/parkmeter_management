<Application x:Class="SimulatorWPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Colors -->
        <Color x:Key="BgDark">#060C1A</Color>
        <Color x:Key="BgCard">#0F172A</Color>
        <Color x:Key="BgHeader">#080E1C</Color>
        <Color x:Key="AccentBlue">#6366F1</Color>
        <Color x:Key="Green">#10B981</Color>
        <Color x:Key="Yellow">#F59E0B</Color>
        <Color x:Key="Red">#EF4444</Color>
        <Color x:Key="TextPrimary">#F1F5F9</Color>
        <Color x:Key="TextMuted">#475569</Color>
        <Color x:Key="Border">#1E293B</Color>

        <SolidColorBrush x:Key="BgDarkBrush" Color="#060C1A"/>
        <SolidColorBrush x:Key="BgCardBrush" Color="#0F172A"/>
        <SolidColorBrush x:Key="BgHeaderBrush" Color="#080E1C"/>
        <SolidColorBrush x:Key="AccentBlueBrush" Color="#6366F1"/>
        <SolidColorBrush x:Key="GreenBrush" Color="#10B981"/>
        <SolidColorBrush x:Key="YellowBrush" Color="#F59E0B"/>
        <SolidColorBrush x:Key="RedBrush" Color="#EF4444"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F1F5F9"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#475569"/>
        <SolidColorBrush x:Key="BorderBrush2" Color="#1E293B"/>
        <SolidColorBrush x:Key="TransparentBrush" Color="Transparent"/>

        <!-- Button Style -->
        <Style x:Key="DarkButton" TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#334155"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#475569"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AlertButton" TargetType="Button" BasedOn="{StaticResource DarkButton}">
            <Setter Property="Background" Value="#3F151520"/>
            <Setter Property="BorderBrush" Value="#EF444440"/>
            <Setter Property="Foreground" Value="#EF4444"/>
        </Style>

        <Style x:Key="OpButton" TargetType="Button" BasedOn="{StaticResource DarkButton}">
            <Setter Property="Background" Value="#1E3A5F20"/>
            <Setter Property="BorderBrush" Value="#3B82F640"/>
            <Setter Property="Foreground" Value="#3B82F6"/>
        </Style>

        <Style x:Key="PowerOnButton" TargetType="Button" BasedOn="{StaticResource DarkButton}">
            <Setter Property="Background" Value="#10B98115"/>
            <Setter Property="BorderBrush" Value="#10B981"/>
            <Setter Property="Foreground" Value="#10B981"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="PowerOffButton" TargetType="Button" BasedOn="{StaticResource DarkButton}">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="Foreground" Value="#475569"/>
        </Style>

        <!-- ScrollBar Style -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="Width" Value="6"/>
        </Style>
    </Application.Resources>
</Application>
